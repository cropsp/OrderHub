# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://crm:crm_pass@postgres:5432/crm_db
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_pass
POSTGRES_DB=crm_db

# ─── Security ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-generate-a-real-secret-key-min-32

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-a-real-fernet-key

# ─── Email (SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=My Leather Shop

# ─── App Settings ─────────────────────────────────────────
BASE_CURRENCY=USD
FRONTEND_URL=http://localhost:3000
UPLOADS_DIR=/app/uploads
ENVIRONMENT=development

# ─── MCP Server ───────────────────────────────────────────
MCP_SERVER_PORT=3001
