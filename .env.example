# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://crm:crm_pass@postgres:5432/crm_db
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_pass
POSTGRES_DB=crm_db

# ─── Security ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-generate-a-real-secret-key-min-32

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-a-real-fernet-key

# Optional: independent signing key for refresh tokens (SEC-01).
# If unset, the app derives one from SECRET_KEY for backward compat and logs a
# startup warning. Generate with the same command as SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Setting this for the first time (or rotating it) invalidates ALL existing
# refresh tokens — every user will be logged out at next page load.
# REFRESH_SECRET_KEY=

# ─── Email (SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=My Leather Shop

# ─── App Settings ─────────────────────────────────────────
BASE_CURRENCY=USD
FRONTEND_URL=http://localhost:3000
UPLOADS_DIR=/app/uploads
ENVIRONMENT=development

# ─── MCP Server ───────────────────────────────────────────
MCP_SERVER_PORT=3001

# ─── ID-Laser draft pipeline (S005) ───────────────────────
# Defaults match the git submodule layout (backend/external/idlaser
# COPYed to /app/external/idlaser in the image). Override only if you've
# relocated the submodule or are running bare-metal from a different
# path. The pre-S005 bind-mount paths (/idlaser/...) are obsolete — see
# CLAUDE.md "ID-Laser draft pipeline" for the post-S005 layout.
# IDLASER_TEMPLATE_PATH=/app/external/idlaser/7001.svg
# IDLASER_MODEL_PATH=/app/external/idlaser/models/card_detector.onnx
# IDLASER_TIMEOUT_S=60
