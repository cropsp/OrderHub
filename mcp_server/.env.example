# OrderHub MCP server — copy to mcp_server/.env (git-ignored) and fill in.
#
# These can equally be supplied through the `env` block of your MCP client's
# server config; the client's environment wins over this file only if you export
# them, since python-dotenv does not override already-set variables.

# Where OrderHub lives. Dev: http://localhost:8000. Prod: https://orderhub.orderapp.uk
ORDERHUB_API_URL=http://localhost:8000

# The dedicated agent user. Role MANAGER with explicit shop grants + view_costs —
# never the owner account (OWNER short-circuits every access check).
ORDERHUB_AGENT_EMAIL=agent@orderhub.dev

# The agent user's password. This is a real login credential: keep it here (this
# file is git-ignored) or in the OS keychain. Revoke by setting the agent user
# is_active=false in the Users admin.
ORDERHUB_AGENT_PASSWORD=

# Optional. Request timeout in seconds.
ORDERHUB_TIMEOUT_S=30
